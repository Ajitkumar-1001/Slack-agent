# FlowPilot AI — backend environment (template)
# Copy to `.env` and fill in real values. Loaded by app/config.py (pydantic-settings).
# Env var names are case-insensitive and map 1:1 to the Settings fields; no prefix.

# ---- Required (app + `alembic upgrade head` will not start without these) ----

# Slack app credentials — https://api.slack.com/apps → your app
SLACK_BOT_TOKEN=              # OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_SIGNING_SECRET=         # Basic Information → Signing Secret

# Anthropic
ANTHROPIC_API_KEY=            # sk-ant-...

# Postgres / Supabase — MUST use the async driver scheme (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# GitHub issue target — PAT needs repo `issues:write`
GITHUB_TOKEN=                 # ghp_...
GITHUB_OWNER=                 # org or user that owns the repo
GITHUB_REPO=                  # repo name (issues are created here)

# ---- Optional (defaults shown; uncomment to override) ----
# DEFAULT_MODEL_PROVIDER=anthropic
# DEFAULT_MODEL_NAME=claude-sonnet-5
# LOG_LEVEL=INFO
